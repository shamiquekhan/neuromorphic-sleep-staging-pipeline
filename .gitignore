logs/
*.log
!results/**/run_logs/*.log
wandb/

# Old pipeline files
neuromorphic_sleep_pipeline.py
run_pipeline.py
run_training.py
files (1)/

# Large data files (use DVC or external storage)
*.npz
*.edf
*.npy

# Datasets are regenerable by Notebooks 01-02 (keep manifests/index/summary only)
data/raw/
data/cache_full/*
!data/cache_full/cache_index.csv
!data/cache_full/preprocessing_summary.json

# Demo cache subset committed for Streamlit Cloud (regenerate:
# python scripts/build_demo_cache.py) — negations must follow *.npy/*.npz
!data/cache_demo/*.npy
!data/cache_demo/*.npz

# Agent skill/worktree dirs (never commit)
.agents/

# Model checkpoints (use release assets)
# *.pt  -- allow final checkpoint for Streamlit Cloud

# Notebook data directories
notebooks/data/

# Primary benchmark: keep metrics/confusion/history + seed aggregates;
# exclude regenerable per-fold prediction dumps and fold checkpoints
results/research/EXP-BENCH-PERSON/**/predictions.csv
results/research/EXP-BENCH-PERSON/**/best_model.pt
results/benchmark_person_level/

# Agent worktrees (never commit)
.kilo/
